<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  FILE:  app/src/main/res/layout/activity_webview.xml
  ============================================================================
  ANDROID STUDIO : app/src/main/res/layout/activity_webview.xml
  AIDE           : <project>/res/layout/activity_webview.xml

  Full-screen directory browser:
    - a thin header showing which server you are browsing
    - the WebView filling the rest of the screen
    - a HUD strip at the bottom showing what the OK button will open
    - a progress bar and an offline/error panel that overlay everything
  ============================================================================
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============ HEADER ============ -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#101720"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <View
                android:id="@+id/header_accent"
                android:layout_width="6dp"
                android:layout_height="22dp"
                android:background="#2563EB" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/header_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="@string/webview_header_hint"
                android:textColor="#5C6675"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============ WEBVIEW ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0B0F14"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ProgressBar
                android:id="@+id/loading_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progress="0"
                android:progressTint="#FF0000"
                android:visibility="gone" />

            <!-- ============ ERROR / OFFLINE PANEL ============ -->
            <LinearLayout
                android:id="@+id/error_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F00B0F14"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_title"
                    android:textColor="#FF6B6B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="#C9D1DC"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/error_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_button"
                        android:focusable="true"
                        android:paddingLeft="28dp"
                        android:paddingRight="28dp"
                        android:text="@string/error_retry"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/error_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:background="@drawable/pill_button"
                        android:focusable="true"
                        android:paddingLeft="28dp"
                        android:paddingRight="28dp"
                        android:text="@string/error_home"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ============ HUD: what OK will open ============ -->
        <TextView
            android:id="@+id/hud_text"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#101720"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textColor="#FFD166"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
