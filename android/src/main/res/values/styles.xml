<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  FILE:  app/src/main/res/values/styles.xml
  ============================================================================
  Deliberately uses the PLATFORM theme (@android:style/...) instead of
  AppCompat, so the project compiles in AIDE with no support-library setup.
  ============================================================================
-->
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Remove the default focus highlight so our red outline is the only cue -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- Edge-to-edge, no status/navigation bars (video playback) -->
    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
