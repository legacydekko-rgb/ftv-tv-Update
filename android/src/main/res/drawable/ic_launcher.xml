<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  FILE:  app/src/main/res/drawable/ic_launcher.xml
  ============================================================================
  Vector app icon: a blue/violet rounded tile with a white play triangle.
  The manifest points android:icon at this drawable, so no PNG mipmaps are
  needed and the project stays text-only (perfect for AIDE).

  If you prefer a real PNG icon set, delete this file, create
  res/mipmap-hdpi/ic_launcher.png etc. and change the manifest back to
  android:icon="@mipmap/ic_launcher".
  ============================================================================
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded gradient tile -->
    <path android:pathData="M0,24 A24,24 0 0 1 24,0 L84,0 A24,24 0 0 1 108,24 L108,84 A24,24 0 0 1 84,108 L24,108 A24,24 0 0 1 0,84 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF2563EB" />
                <item android:offset="1" android:color="#FF7C3AED" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White play triangle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M42,34 L42,74 L76,54 Z" />

    <!-- Red "focus" underline, echoing the app's TV highlight colour -->
    <path
        android:fillColor="#FFFF0000"
        android:pathData="M30,82 L78,82 L78,86 L30,86 Z" />
</vector>
