<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  FILE:  app/src/main/AndroidManifest.xml
  ============================================================================
  ANDROID STUDIO : place at  app/src/main/AndroidManifest.xml
  AIDE           : place at  <project>/AndroidManifest.xml

  IMPORTANT - the <queries> block (Android 11+ / API 30+):
  Android 11 introduced "package visibility". Without the <queries> block below,
  PackageManager.queryIntentActivities() returns an EMPTY list and the app will
  wrongly claim "No video player found" even when VLC is installed.
  Declaring the http/https VIEW intents here is what makes the HTTP fallback
  check in MainActivity work on Android 11+.

  IMPORTANT - there is deliberately NO package="..." attribute here.
  Android Gradle Plugin 8 REJECTS a package attribute in the manifest; the
  application id comes from `namespace` / `applicationId` in build.gradle
  instead. The AIDE copy of this manifest (android/AIDE/AndroidManifest.xml)
  DOES keep package="...", because AIDE does not read Gradle at all.
  ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Directory servers are plain HTTP, and the app must reach the LAN ones too. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Needed on Android 13+ ONLY if you want to hand a stream to a DIFFERENT app
      (e.g. a downloaded .mkv opened in MX Player). It is harmless to keep; if you
      target API 34 you may delete it, but then external hand-off to another app
      for a downloaded file will fail.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- ====================================================================
         HARDWARE FEATURES
         leanback required="false" => installable on TV *and* on phones.
         touchscreen required="false" => installable on TV boxes that have no
         touch screen (without this line the Play Store hides the app from TV).
         ==================================================================== -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!--
          ==================================================================
          SERVER SELECTION DASHBOARD (launcher activity)
          Two intent filters:
            1. LEANBACK_LAUNCHER -> shows the app on the Android TV home row
            2. LAUNCHER          -> shows the app in the normal phone launcher
          ==================================================================
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen WebView directory browser + D-Pad link navigation -->
        <activity
            android:name=".WebViewActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="landscape" />

        <!-- Optional built-in player (only used if you set PREFER_BUILTIN_PLAYER = true) -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.Fullscreen" />

        <!--
          ==================================================================
          ANDROID 11+ PACKAGE VISIBILITY
          Tells the system which other apps we are allowed to *see* when we
          build a "open this video with..." chooser.
          ==================================================================
        -->
        <queries>
            <!-- Lets us detect installed video players / browsers -->
            <intent>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
            </intent>
            <intent>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent>
            <!-- Lets us build a chooser for local / streamed video files -->
            <intent>
                <action android:name="android.intent.action.VIEW" />
                <data android:mimeType="video/*" />
            </intent>

            <!-- Known-good players. Add or remove packages freely. -->
            <package android:name="org.videolan.vlc" />
            <package android:name="com.mxtech.videoplayer.ad" />
            <package android:name="com.mxtech.videoplayer.pro" />
            <package android:name="com.google.android.exoplayer2.demo" />
            <package android:name="tv.plex.app" />
            <package android:name="com.brouken.player" />
            <package android:name="net.gtvbox.videoplayer" />
            <package android:name="com.mxtech.videoplayer" />
        </queries>
    </application>
</manifest>
